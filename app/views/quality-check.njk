{% extends '_layout.njk' %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/search-input.njk" import searchInput %}

{% set pageTitle = "Ledger assignment quality check" %}

{% set hasMultiplePages = totalPages and totalPages > 1 %}

{% set extraQuery = '' %}
{% if frn %}{% set extraQuery = extraQuery ~ '&frn=' ~ frn %}{% endif %}

{% block pageTitle %}
  {% if hasMultiplePages %}
    Page {{ page }} - {{ pageTitle }} - {{ serviceName }}
  {% else %}
    {{ pageTitle }} - {{ serviceName }}
  {% endif %}
{% endblock %}

{% block beforeContent %}
  {{
    govukBreadcrumbs({
      items: [{
        text: "Home",
        href: "/"
      }, {
        text: pageTitle
      }]
    })
  }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if checkComplete %}
        <div
          class="govuk-notification-banner govuk-notification-banner--success"
          role="alert"
          aria-labelledby="govuk-notification-banner-title"
          data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2
              class="govuk-notification-banner__title"
              id="govuk-notification-banner-title">
              Success
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">
              {% set extra = '.' %}
              {% if status == 'Failed' %}
                {% set extra = ' and sent for review.' %}
              {% endif %}
              Ledger assignment for {{ checkComplete }} has been quality
              checked{{ extra }}
            </h3>
          </div>
        </div>
      {% endif %}
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
      <p class="govuk-body">
        Requests that have been through ledger assignment will need to be
        quality checked. Once the quality check is complete and approved, the
        payment request is sent to be processed.
      </p>
      <p class="govuk-body">
        If any payment amounts need to be amended, a further review will be
        needed.
      </p>
      <p class="govuk-body">
        You can search for an individual assignment using the FRN (Firm
        Reference Number) or review all assignments.
      </p>
      {% if qualityCheckData.length %}
        <div class="govuk-!-padding-bottom-3">
          <div class="govuk-!-width-one-third">
            <form
              action="/quality-check"
              method="POST">
              <input
                type="hidden"
                name="crumb"
                value="{{crumb}}"
              />
              {{ searchInput(model) }}
              <div class="govuk-button-group">
                {{
                  govukButton({
                    text: "Search",
                    classes: "govuk-button govuk-!-margin-top-2"
                  })
                }}
                <a
                  href="/quality-check"
                  class="govuk-link govuk-link--no-visited-state">Reset
                  table</a>
              </div>
            </form>
          </div>

          <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
              <div style="display:flex;align-items:baseline;gap:1rem;">
                <h2 class="govuk-heading-m">
                  Ledger assignments
                </h2>
              </div>
            </div>

            {% if hasMultiplePages %}
              <div class="govuk-grid-column-one-half govuk-!-padding-top-1">
                <div
                  style="display:flex;align-items:baseline;justify-content:flex-end;">
                  <div
                    class="govuk-body-s"
                    aria-label="Records per page"
                    style="white-space:nowrap;vertical-align:baseline;">
                    <span>Number of records per page:</span>&nbsp;
                    {% set perPageOptions = [100, 500, 1000] %}
                    {% for opt in perPageOptions %}
                      {% if perPage == opt %}
                        <strong>{{ opt }}</strong>
                      {% else %}
                        <a
                          href="/quality-check?perPage={{ opt }}&page=1{{ extraQuery }}"
                          class="govuk-link">{{ opt }}</a>
                      {% endif %}
                      {% if not loop.last %}
                        &nbsp;|&nbsp;
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
          <p
            class="govuk-body-m"
            id="dataset-count">
            Showing {{ qualityCheckData.length }} of {{ count }} assignment{{
              's' if qualityCheckData.length != 1
            }}
          </p>

          {% set tableRows = [] %}
          {% for qualityCheck in qualityCheckData %}
            {% set actionHtml %}
              {%
                if qualityCheck.status == 'Pending' and qualityCheck.paymentRequest.manualLedgerChecks[0].createdById != user.userId
              %}
                <a
                  href="/manual-ledger-review?paymentrequestid={{qualityCheck.paymentRequest.paymentRequestId}}"
                  class="govuk-link"
                  aria-label="Review invoice {{ qualityCheck.paymentRequest.invoiceNumber }} for FRN {{ qualityCheck.paymentRequest.frn }}">Review</a>
              {% endif %}
            {% endset %}

            {%
              set tableRows = (tableRows.push([
                { text: qualityCheck.paymentRequest.schemes.name, classes: "govuk-body-s" },
                { text: qualityCheck.paymentRequest.marketingYear, classes: "govuk-body-s" },
                { text: qualityCheck.paymentRequest.frn, classes: "govuk-body-s" },
                { text: qualityCheck.paymentRequest.agreementNumber, classes: "govuk-body-s" },
                { text: qualityCheck.paymentRequest.invoiceNumber, classes: "govuk-body-s" },
                { text: qualityCheck.paymentRequest.paymentRequestNumber, format: "numeric", classes: "govuk-body-s" },
                { text: qualityCheck.paymentRequest.valueText, format: "numeric", classes: "govuk-body-s noWrap" },
                { text: qualityCheck.paymentRequest.manualLedgerChecks[0].createdBy, classes: "govuk-body-s" },
                { text: qualityCheck.hasDismissed, classes: "govuk-body-s" },
                { html: actionHtml, classes: "govuk-body-s" }
              ]), tableRows)
            %}
          {% endfor %}

          {{
            govukTable({
              head: [
                { text: "Scheme", classes: "govuk-body-s" },
                { text: "Scheme year", classes: "govuk-body-s" },
                { text: "FRN", classes: "govuk-body-s" },
                { text: "Agreement number", classes: "govuk-body-s" },
                { text: "Invoice number", classes: "govuk-body-s" },
                { text: "Requests", format: "numeric", classes: "govuk-body-s" },
                { text: "Total amount", format: "numeric", classes: "govuk-body-s" },
                { text: "Reviewed by", classes: "govuk-body-s" },
                { text: "Ledger changed", classes: "govuk-body-s" },
                { text: "Actions", classes: "govuk-body-s" }
              ],
              rows: tableRows
            })
          }}

          {% if hasMultiplePages %}
            {% set paginationPrevious = undefined %}
            {% set paginationNext = undefined %}

            {% if page > 1 %}
              {%
                set paginationPrevious = {
                  href: "?page=" + (page - 1) + "&perPage=" + perPage + extraQuery,
                  labelText: "Previous page"
                }
              %}
            {% endif %}

            {% if page < totalPages %}
              {%
                set paginationNext = {
                  href: "?page=" + (page + 1) + "&perPage=" + perPage + extraQuery,
                  labelText: "Next page"
                }
              %}
            {% endif %}

            {{
              govukPagination({
                previous: paginationPrevious,
                next: paginationNext,
                items: paginationItems
              })
            }}
          {% endif %}
        </div>
      {% else %}
        <div class="govuk-inset-text">
          {% if frn %}
            No ledger assignments awaiting quality check were found for the FRN.
            Check details and try again, or
            <a
              href="/quality-check"
              class="govuk-link govuk-link--no-visited-state">reset table</a>
            to view all ledger assignments awaiting quality check.
          {% else %}
            No ledger assignments awaiting quality check were found.
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
